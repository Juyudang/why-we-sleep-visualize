# 이 저장소는 빌드 단계가 없는 정적 사이트다.
# 소스(html/css/js)는 전부 추적하고, 아래 항목만 로컬에 남긴다.

# ── 운영체제 ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ── 에디터 / IDE ──────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# ── 에이전트 도구 상태 ────────────────────────────────────
# .omc는 세션마다 새로 쌓이는 로컬 상태라 공유하지 않는다.
.omc/
# 워크트리는 저장소 안에 만들어지지만 그 자체가 체크아웃이다.
.claude/worktrees/
# launch.json(프리뷰 서버 설정)은 공유하고, 개인 권한 설정만 제외한다.
.claude/settings.local.json

# ── 나중에 도구를 붙일 경우 ───────────────────────────────
node_modules/
dist/
build/
.cache/
*.log
npm-debug.log*
yarn-error.log*
__pycache__/

# ── 로컬 환경값 ───────────────────────────────────────────
.env
.env.*
!.env.example
